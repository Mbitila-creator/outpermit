# Copy these values into the production platform's protected environment.
# Never commit the completed production file or real secrets.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=GENERATE_A_LONG_RANDOM_VALUE
DJANGO_ALLOWED_HOSTS=example.gov.tz,www.example.gov.tz
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.gov.tz,https://www.example.gov.tz
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_BEHIND_HTTPS_PROXY=true
DJANGO_SESSION_COOKIE_AGE=28800
DJANGO_SESSION_EXPIRE_AT_BROWSER_CLOSE=true
DJANGO_CACHE_LOCATION=/tmp/outpermit-shared-cache
LOGIN_THROTTLE_ATTEMPTS=5
LOGIN_THROTTLE_SECONDS=900

DB_ENGINE=mysql
DB_NAME=outpermit
DB_USER=outpermit_application
DB_PASSWORD=CHANGE_ME
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60

PUBLIC_BASE_URL=https://example.gov.tz
REMINDER_SCHEDULER_TOKEN=GENERATE_A_SEPARATE_RANDOM_VALUE
